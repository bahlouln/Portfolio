---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Link from "../components/ui/link.astro";
import Icon from "../components/ui/Icon/Icon.astro";
---

<BaseLayout title="About | Nour Bahloul" description="About Nour Bahloul">
  <div class="stack gap-20">
    <header class="wrapper hero">
      <Hero align="center" title="About мe" tagline="A Glimpse into My Life" />
      <img
        alt="illustration of profile page"
        src="/assets/illustrations/about.svg"
      />
    </header>

    <main class="wrapper about">
      <section>
        <h2 class="section-title">Background</h2>
        <div class="content">
          <p>
  I'm Nour Bahloul, a Software Engineer specialized in Full Stack Development
  and passionate about Artificial Intelligence. I enjoy developing modern web
  applications and exploring innovative technologies to solve real-world
  challenges. I'm always eager to learn, improve my technical skills, and
  transform ideas into efficient and practical software solutions.
</p>
        </div>
      </section>
      <section>
        <h2 class="section-title">Education</h2>
        <div class="content">
          <strong>
            🎓 Engineering Degree in Software Engineering
          </strong>
          <p>International Institute of Technology (IIT), Sfax, Tunisia</p>
          <p class="year">2023 – 2026</p>
          <strong>
            🎓 Engineering School Entry Diploma
          </strong>
          <p>Faculty of Sciences of Sfax (FSS), Tunisia</p>
          <p class="year">2023</p>
          <strong>
            🎓 Baccalaureate in Experimental Sciences
          </strong>
          <p>Lycée Mongi Slim, Sfax, Tunisia</p>
          <p class="year">2021</p>
        </div>
      </section>
      <section>
  <h2 class="section-title">Skills</h2>
  <div class="content">
    <strong>💻 Languages & Frameworks</strong>
    <p> TypeScript, JavaScript,C#, Python, Java </p>

    <strong>⚛️ Front-End</strong>
    <p> React.js, Angular, Tailwind CSS, Material-UI</p>

    <strong>🖥️ Back-End</strong>
    <p>ASP.NET Core, Node.js/Express.js, Spring Boot </p>
    <strong>🗄️ Databases</strong>

    <p>MongoDB, SQL Server, MySQL, SQLite</p>
    <strong>🔎 Database Query Language</strong>
    <p>SQL ,NoSQL</p>
    <strong>🤖 AI & Data</strong>
    <p>Machine Learning, Deep Learning (TensorFlow, Keras, PyTorch), Generative AI </p>
    <strong>🛠️ DevOps & Tools</strong>

    <p>Docker, Git, GitHub, GitLab, Jenkins </p>


  </div>
</section>

      <section>
        <Link
          class="link"
          href="/projects"
          style="rounded"
          title="See My Projects"
        >
          <Icon icon="code" size="1.33em" /> See My Projects
        </Link>
      </section>
    </main>
  </div>
</BaseLayout>

<style lang="scss">
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-inline: 2.5rem;
    gap: 1.5rem;

    img {
      width: 100%;
      max-width: 22rem;
    }
  }

  .about {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--gray-200);

    .link {
      justify-self: center;
      align-self: center;
      grid-column: 1 / -1;
    }
  }

  .section-title {
    grid-column-start: 1;
    font-size: var(--text-xl);
    color: var(--gray-0);
  }

  .content {
    grid-column: 2 / 4;

    p:not(:last-child) {
      margin-bottom: 1rem;
    }
  }

  @media (min-width: 50em) {
    .hero {
      flex-direction: row;
      gap: 6rem;
    }

    .about {
      display: grid;
      grid-template-columns: 1fr 60% 1fr;
    }

    section {
      display: contents;
      font-size: var(--text-lg);
    }
  }
</style>
